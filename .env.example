# Model provider: openai | anthropic | stub
# "stub" runs the deterministic scripted model used by tests and the offline demo.
MODEL_PROVIDER=stub
MODEL_NAME=gpt-4o-mini

# OpenAI-compatible provider (also works with local gateways via OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic provider
ANTHROPIC_API_KEY=

# Runtime
MAX_STEPS=25
MAX_RETRIES=2
TOOL_TIMEOUT_SECONDS=15
