# Model provider: openai | anthropic | stub
# "stub" runs the deterministic scripted model used by tests and the offline demo.
MODEL_PROVIDER=stub
MODEL_NAME=gpt-4o-mini

# Phase-3 names (win over MODEL_PROVIDER/MODEL_NAME when set).
# Demo with a real model: LLM_PROVIDER=anthropic + LLM_API_KEY=<your key>.
# claude-sonnet-4-6 is the default model for the anthropic provider.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# STUB_MODEL=1 forces the stub regardless of provider (tests set this).
STUB_MODEL=

# OpenAI-compatible provider (also works with local gateways via OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic provider
ANTHROPIC_API_KEY=

# Runtime
MAX_STEPS=25
MAX_RETRIES=2
TOOL_TIMEOUT_SECONDS=15
