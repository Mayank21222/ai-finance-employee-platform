# --- Model selection ---------------------------------------------------------
# stub            : deterministic offline demo model, no API key needed (DEFAULT)
# local           : any OpenAI-compatible local endpoint (Ollama, vLLM, LM Studio)
# groq            : fast hosted OpenAI-compatible models (needs GROQ_API_KEY)
# openai/anthropic/gemini : optional cloud providers
#
# The platform runs out of the box with NO paid API key: MODEL_PROVIDER defaults
# to `stub` when unset, and any cloud provider without a configured key degrades
# to the offline stub automatically.
MODEL_PROVIDER=stub
MODEL_NAME=llama3.1:8b
MODEL_BASE_URL=http://localhost:11434/v1   # only used when MODEL_PROVIDER=local
EMPLOYEE_MODEL=stub                  # model each new AI employee is created with (groq|local|stub)
GROQ_API_KEY=                        # <-- paste your Groq key here (never committed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Services -----------------------------------------------------------------
APP_BASE_URL=http://127.0.0.1:8001   # mock payables app (sandbox)
DASHBOARD_PORT=8000                  # low-code platform dashboard
DATA_DIR=company_data                # invoices, policies, procedures
STORAGE_DIR=.data                    # sqlite checkpoints, run traces, memory, logs

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO                       # all traces also stream to .data/logs/traces.jsonl